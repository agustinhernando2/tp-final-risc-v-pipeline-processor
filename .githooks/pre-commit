#!/usr/bin/env bash
# Format staged .sv files with verible-verilog-format before commit.

VERIBLE=$(command -v verible-verilog-format 2>/dev/null \
  || echo "$HOME/.local/bin/verible-verilog-format")

if [[ ! -x "$VERIBLE" ]]; then
  echo "pre-commit: verible-verilog-format not found, skipping format" >&2
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sv$')
[[ -z "$staged" ]] && exit 0

while IFS= read -r file; do
  "$VERIBLE" --inplace --indentation_spaces=4 "$file"
  git add "$file"
done <<< "$staged"

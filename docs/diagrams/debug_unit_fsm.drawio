<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="debugunit-fsm" name="DebugUnit-FSM">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITULO ===================== -->
        <mxCell id="title" value="DebugUnit  -  FSM de control via UART  (corre en flanco DESCENDENTE del reloj)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== ESTADO INICIAL ===================== -->
        <mxCell id="start_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== ESTADOS ===================== -->
        <mxCell id="s_initial" value="INITIAL&#10;(reposo)&#10;&#10;pipeline_enable = 0&#10;espera comando" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s_writeim" value="WRITE_IM&#10;(carga de programa)&#10;&#10;pipeline_enable = 0&#10;ensambla 4 bytes -&gt; word&#10;o_imem_wr al 4to byte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="215" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s_ready" value="READY&#10;(programa cargado)&#10;&#10;pipeline_enable = 0&#10;espera CONTINUE / STEP_BY_STEP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="220" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s_run" value="RUN&#10;(ejecucion continua)&#10;&#10;pipeline_enable = 1&#10;corre hasta i_halt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="420" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s_step" value="STEP_MODE&#10;(paso a paso)&#10;&#10;pipeline_enable = 0 (entre pasos)&#10;CMD_STEP -&gt; enable=1 un ciclo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="220" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- ===================== DUMP (SEND_*) ===================== -->
        <mxCell id="dump_box" value="DUMP de estado  (tx MSB-first, pipeline_enable = 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;align=center;spacingTop=6;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="900" height="220" as="geometry" />
        </mxCell>

        <mxCell id="s_pc" value="SEND_PC&#10;&#10;tx_data = msb_byte(PC, byte_idx)&#10;PC = 8 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="700" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s_reg" value="SEND_REG&#10;&#10;tx_data = msb_byte(reg, byte_idx)&#10;32 registros x 8 bytes&#10;o_reg_addr = reg_idx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s_mem" value="SEND_MEM&#10;&#10;tx_data = msb_byte(mem, byte_idx)&#10;DM_DEPTH words x 8 bytes&#10;o_mem_data_addr = mem_idx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="700" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== TRANSICIONES ===================== -->
        <!-- start -> INITIAL -->
        <mxCell id="e_start" value="reset" style="endArrow=block;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="start_dot" target="s_initial">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- INITIAL -> WRITE_IM -->
        <mxCell id="e_init_wr" value="rx_done &amp; data==1&#10;(CMD_WRITE_IM)" style="endArrow=block;html=1;strokeColor=#82b366;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_initial" target="s_writeim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WRITE_IM self loop -->
        <mxCell id="e_wr_self" value="rx_done: acumula byte&#10;(MSB-first)" style="endArrow=block;html=1;strokeColor=#82b366;fontSize=10;fontColor=#333333;rounded=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_writeim" target="s_writeim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="460" y="170" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- WRITE_IM -> READY -->
        <mxCell id="e_wr_ready" value="ultimo word&#10;(word_count==IM_WORDS-1)" style="endArrow=block;html=1;strokeColor=#82b366;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_writeim" target="s_ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- READY -> RUN -->
        <mxCell id="e_ready_run" value="rx_done &amp; data==2&#10;(CMD_CONTINUE)" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_ready" target="s_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- READY -> STEP_MODE -->
        <mxCell id="e_ready_step" value="rx_done &amp; data==3&#10;(CMD_STEP_BY_STEP)" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_ready" target="s_step">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RUN self loop -->
        <mxCell id="e_run_self" value="!i_halt: avanza&#10;(enable=1)" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;fontColor=#333333;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_run" target="s_run">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="960" y="470" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP_MODE self via STEP -> goes through SEND_PC then back; show CMD_STEP returns -->
        <mxCell id="e_step_run" value="rx_done &amp; data==2&#10;(CMD_CONTINUE)" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_step" target="s_run">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1170" y="470" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- INITIAL -> SEND_PC (SEND_INFO, prev=INITIAL) -->
        <mxCell id="e_init_dump" value="rx_done &amp; data==4&#10;(CMD_SEND_INFO)&#10;prev=INITIAL" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#333333;dashed=1;" edge="1" parent="1" source="s_initial" target="s_pc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="130" y="755" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- READY -> SEND_PC (SEND_INFO, prev=READY) -->
        <mxCell id="e_ready_dump" value="rx_done &amp; data==4&#10;(CMD_SEND_INFO)&#10;prev=READY" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#333333;dashed=1;" edge="1" parent="1" source="s_ready" target="s_pc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="500" y="500" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- RUN -> SEND_PC (halt, prev=READY) -->
        <mxCell id="e_run_dump" value="i_halt&#10;prev=READY&#10;enable=0" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_run" target="s_pc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="620" y="660" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP_MODE -> SEND_PC (STEP o SEND_INFO o halt, prev=STEP_MODE/READY) -->
        <mxCell id="e_step_dump" value="rx_done &amp; data==5 (CMD_STEP): enable=1 un ciclo, prev=STEP_MODE&#10;rx_done &amp; data==4 (SEND_INFO): prev=STEP_MODE&#10;i_halt: prev=READY" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_step" target="s_mem">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1290" y="540" /><mxPoint x="1290" y="680" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- SEND_PC -> SEND_REG -->
        <mxCell id="e_pc_reg" value="tx_done &amp; byte_idx==7&#10;(PC completo)" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_pc" target="s_reg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SEND_PC self loop -->
        <mxCell id="e_pc_self" value="tx_done: byte_idx++" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=9;fontColor=#666666;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pc" target="s_pc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="370" y="850" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- SEND_REG -> SEND_MEM -->
        <mxCell id="e_reg_mem" value="tx_done &amp; reg_idx==31 &amp; byte_idx==7&#10;(32 regs completos)" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s_reg" target="s_mem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SEND_REG self loop -->
        <mxCell id="e_reg_self" value="tx_done: byte_idx++/reg_idx++" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=9;fontColor=#666666;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_reg" target="s_reg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="670" y="850" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- SEND_MEM self loop -->
        <mxCell id="e_mem_self" value="tx_done: byte_idx++/mem_idx++" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=9;fontColor=#666666;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_mem" target="s_mem">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="970" y="850" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- SEND_MEM -> r_prev (return) -->
        <mxCell id="e_mem_return" value="tx_done &amp; mem_idx==DM_DEPTH-1 &amp; byte_idx==7&#10;-&gt; vuelve a r_prev (INITIAL / READY / STEP_MODE)" style="endArrow=block;html=1;strokeColor=#b85450;fontSize=10;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="s_mem" target="s_ready">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1150" y="600" /><mxPoint x="1150" y="380" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== LEYENDAS ===================== -->
        <mxCell id="leg_cmd" value="Comandos UART (1 byte):&#10;1 = CMD_WRITE_IM      (cargar programa)&#10;2 = CMD_CONTINUE      (ejecucion continua)&#10;3 = CMD_STEP_BY_STEP  (entrar a paso a paso)&#10;4 = CMD_SEND_INFO     (volcar estado)&#10;5 = CMD_STEP          (avanzar un ciclo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="220" width="340" height="140" as="geometry" />
        </mxCell>

        <mxCell id="leg_notes" value="Notas:&#10;- o_state es one-hot (1 LED por estado).&#10;- La FSM corre en negedge; el pipeline en posedge,&#10;  asi enable/mem_wr quedan estables (sin carreras).&#10;- Dump siempre en orden: PC -&gt; 32 regs -&gt; mem de datos,&#10;  cada valor de 8 bytes MSB-first.&#10;- r_prev guarda a donde volver al terminar el dump.&#10;- En CMD_STEP el enable=1 dura un solo ciclo: SEND_PC&#10;  lo vuelve a 0 en el flanco siguiente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="380" width="340" height="200" as="geometry" />
        </mxCell>

        <mxCell id="leg_color" value="Colores:  azul=reposo/espera   verde=carga   naranja=ejecucion   violeta=dump" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="880" width="900" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

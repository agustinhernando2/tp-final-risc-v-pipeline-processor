<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="host-uart-debug-pipeline" name="Host-UART-Debug-Pipeline">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0" background="#0d1117">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== FONDO ===================== -->
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d1117;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1800" height="1050" as="geometry" />
        </mxCell>

        <!-- ===================== TITULO ===================== -->
        <mxCell id="title" value="Comunicacion Host &#8594; UART &#8594; DebugUnit &#8594; Pipeline RISC-V" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#e6edf3;" vertex="1" parent="1">
          <mxGeometry x="400" y="28" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="como se integra el subsistema de comunicacion/control con tu datapath de 5 etapas" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#8b949e;" vertex="1" parent="1">
          <mxGeometry x="400" y="62" width="1000" height="22" as="geometry" />
        </mxCell>

        <!-- ===================== HOST (externo) ===================== -->
        <mxCell id="host" value="&lt;b&gt;Computadora (Host)&lt;/b&gt;&#10;&#10;GUI: riscv_debug.py&#10;puerto serie USB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#58a6ff;fontColor=#c9d1d9;fontSize=12;align=center;arcSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="170" height="120" as="geometry" />
        </mxCell>

        <!-- ===================== FPGA (contenedor) ===================== -->
        <mxCell id="fpga" value="FPGA Basys-3  -  RiscvTop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#30363d;dashed=1;verticalAlign=top;fontSize=14;fontStyle=1;align=left;fontColor=#8b949e;spacingLeft=14;spacingTop=10;arcSize=2;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="240" y="150" width="1500" height="680" as="geometry" />
        </mxCell>

        <!-- ===================== UART ===================== -->
        <mxCell id="uart" value="&lt;b&gt;UART&lt;/b&gt;&#10;8N1 - 19200 baud&#10;&#10;BaudRateGenerator&#10;UartRx (serie&#8594;par)&#10;UartTx (par&#8594;serie)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#3fb950;fontColor=#c9d1d9;fontSize=11;align=center;arcSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="360" width="170" height="160" as="geometry" />
        </mxCell>

        <!-- ===================== DEBUG UNIT (barra controladora) ===================== -->
        <mxCell id="debug" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c1606;strokeColor=#d29922;fontColor=#f0e6c8;fontSize=12;align=left;arcSize=4;strokeWidth=3;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="1250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="debug_t" value="&lt;b&gt;DebugUnit&lt;/b&gt;  -  FSM de control via UART  (corre en flanco descendente del reloj)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#f0c84b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="362" width="1100" height="22" as="geometry" />
        </mxCell>
        <mxCell id="debug_d" value="Traduce comandos UART (1 byte) en control del core:&#10;&#160;&#160;1 WRITE_IM &#8594; carga el programa (ensambla bytes en words y los escribe en InstructionMemory)&#10;&#160;&#160;2 CONTINUE &#8594; RUN: corre el pipeline hasta HALT&#160;&#160;&#160;&#160;3 STEP_BY_STEP / 5 STEP &#8594; avanza 1 ciclo&#10;&#160;&#160;4 SEND_INFO &#8594; DUMP: PC + 32 registros + memoria de datos &#8594; UART &#8594; Host&#10;FSM one-hot (8 estados, 1 LED c/u).  Diagrama detallado: debug_unit_fsm.drawio" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#d8c79a;" vertex="1" parent="1">
          <mxGeometry x="490" y="388" width="1180" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== PIPELINE (contenedor + etapas) ===================== -->
        <mxCell id="pipe" value="PIPELINE RISC-V  -  tu datapath  (IF &#8594; ID &#8594; EX &#8594; MEM &#8594; WB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6e7681;verticalAlign=top;fontSize=13;fontStyle=1;align=center;fontColor=#adbac7;spacingTop=8;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="1250" height="200" as="geometry" />
        </mxCell>

        <mxCell id="st_if" value="&lt;b&gt;IF&lt;/b&gt;&#10;InstructionFetch&#10;+ InstructionMemory&#10;(puerto de carga)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c5c18;strokeColor=#b9b526;fontColor=#f7f7e0;fontSize=11;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="650" width="226" height="120" as="geometry" />
        </mxCell>
        <mxCell id="st_id" value="&lt;b&gt;ID&lt;/b&gt;&#10;InstructionDecode&#10;+ RegisterFile&#10;(puerto dbg lectura)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#125c5a;strokeColor=#2bb7b3;fontColor=#e0f7f6;fontSize=11;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="724" y="650" width="226" height="120" as="geometry" />
        </mxCell>
        <mxCell id="st_ex" value="&lt;b&gt;EX&lt;/b&gt;&#10;Execute / ALU&#10;&#10;(sin tap de debug)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b4488;strokeColor=#4d8bf0;fontColor=#e6efff;fontSize=11;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="968" y="650" width="226" height="120" as="geometry" />
        </mxCell>
        <mxCell id="st_mem" value="&lt;b&gt;MEM&lt;/b&gt;&#10;MemoryAccess&#10;+ DataMemory (puerto dbg)&#10;deteccion de HALT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2470;strokeColor=#b969d6;fontColor=#f5e9fb;fontSize=11;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1212" y="650" width="226" height="120" as="geometry" />
        </mxCell>
        <mxCell id="st_wb" value="&lt;b&gt;WB&lt;/b&gt;&#10;WriteBack&#10;&#10;HALT llega a WB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#185c39;strokeColor=#34c77b;fontColor=#e2f8ec;fontSize=11;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1456" y="650" width="226" height="120" as="geometry" />
        </mxCell>

        <!-- flechas internas del pipeline -->
        <mxCell id="p1" style="endArrow=classicThin;html=1;strokeColor=#6e7681;strokeWidth=1.5;" edge="1" parent="1" source="st_if" target="st_id"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2" style="endArrow=classicThin;html=1;strokeColor=#6e7681;strokeWidth=1.5;" edge="1" parent="1" source="st_id" target="st_ex"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3" style="endArrow=classicThin;html=1;strokeColor=#6e7681;strokeWidth=1.5;" edge="1" parent="1" source="st_ex" target="st_mem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4" style="endArrow=classicThin;html=1;strokeColor=#6e7681;strokeWidth=1.5;" edge="1" parent="1" source="st_mem" target="st_wb"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== HOST <-> UART (serie) ===================== -->
        <mxCell id="e_irx" value="i_rx" style="endArrow=block;html=1;strokeColor=#58a6ff;fontColor=#58a6ff;strokeWidth=2;labelBackgroundColor=#0d1117;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="host" target="uart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_otx" value="o_tx" style="endArrow=block;html=1;strokeColor=#58a6ff;fontColor=#58a6ff;strokeWidth=2;labelBackgroundColor=#0d1117;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="uart" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_serie" value="linea serie (USB)" style="text;html=1;align=center;fontSize=10;fontColor=#58a6ff;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="190" y="330" width="120" height="18" as="geometry" />
        </mxCell>

        <!-- ===================== UART <-> DEBUG ===================== -->
        <mxCell id="e_rxd" value="o_rx_data[7:0]&#10;o_rx_done_tick" style="endArrow=block;html=1;strokeColor=#56d4dd;fontColor=#56d4dd;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="uart" target="debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_txd" value="i_tx_data / i_tx_start&#10;o_tx_done_tick" style="endArrow=block;html=1;strokeColor=#56d4dd;fontColor=#56d4dd;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="debug" target="uart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== DEBUG <-> PIPELINE (taps) ===================== -->
        <!-- ENABLE global (ambar) -->
        <mxCell id="e_enable" value="o_pipeline_enable &#8594; i_if_enable&#10;(habilita / congela TODAS las etapas:&#10;PC, buffers, RegFile WR, DataMem WR)" style="endArrow=block;html=1;strokeColor=#d29922;fontColor=#e3b341;strokeWidth=3;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.02;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="debug" target="pipe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="475" y="560" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- CARGA de programa (verde) -> IF -->
        <mxCell id="e_load" value="o_imem_wr / o_imem_addr&#10;o_imem_data &#8594; InstructionMemory" style="endArrow=block;html=1;strokeColor=#3fb950;fontColor=#56d364;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="debug" target="st_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PC out (violeta, sube) <- IF -->
        <mxCell id="e_pc" value="i_pc &#8592; o_PC" style="endArrow=block;html=1;strokeColor=#a371f7;fontColor=#bf93f9;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.16;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_if" target="debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- REG addr/data (violeta) <-> ID -->
        <mxCell id="e_regaddr" value="o_reg_addr &#8594;" style="endArrow=block;html=1;strokeColor=#a371f7;fontColor=#bf93f9;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="debug" target="st_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_regdata" value="&#8592; i_reg_data" style="endArrow=block;html=1;strokeColor=#a371f7;fontColor=#bf93f9;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.33;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_id" target="debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MEM addr/data (violeta) <-> MEM -->
        <mxCell id="e_memaddr" value="o_mem_data_addr &#8594;" style="endArrow=block;html=1;strokeColor=#a371f7;fontColor=#bf93f9;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.68;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="debug" target="st_mem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_memdata" value="&#8592; i_mem_data" style="endArrow=block;html=1;strokeColor=#a371f7;fontColor=#bf93f9;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.72;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="debug" target="st_mem">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1360" y="560" /><mxPoint x="1325" y="630" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- HALT (violeta, sube) <- MEM/WB -->
        <mxCell id="e_halt" value="i_halt &#8592; o_halt (HALT en MEM/WB)" style="endArrow=block;html=1;strokeColor=#a371f7;fontColor=#bf93f9;strokeWidth=2;labelBackgroundColor=#0d1117;fontSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.78;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_mem" target="debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== LEYENDA DE COLORES ===================== -->
        <mxCell id="leg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#30363d;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="860" width="640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="leg_t" value="Referencias de senales" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#c9d1d9;" vertex="1" parent="1">
          <mxGeometry x="258" y="870" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="" style="endArrow=block;html=1;strokeColor=#58a6ff;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="906" as="sourcePoint" /><mxPoint x="312" y="906" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg1t" value="serie Host&#8596;UART (i_rx / o_tx)" style="text;html=1;align=left;fontSize=10;fontColor=#adbac7;" vertex="1" parent="1"><mxGeometry x="320" y="897" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg2" value="" style="endArrow=block;html=1;strokeColor=#56d4dd;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="934" as="sourcePoint" /><mxPoint x="312" y="934" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg2t" value="paralelo UART&#8596;DebugUnit (bytes)" style="text;html=1;align=left;fontSize=10;fontColor=#adbac7;" vertex="1" parent="1"><mxGeometry x="320" y="925" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg3" value="" style="endArrow=block;html=1;strokeColor=#3fb950;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="962" as="sourcePoint" /><mxPoint x="312" y="962" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg3t" value="carga de programa &#8594; InstructionMemory" style="text;html=1;align=left;fontSize=10;fontColor=#adbac7;" vertex="1" parent="1"><mxGeometry x="320" y="953" width="280" height="18" as="geometry" /></mxCell>
        <mxCell id="lg4" value="" style="endArrow=block;html=1;strokeColor=#d29922;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="990" as="sourcePoint" /><mxPoint x="312" y="990" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg4t" value="enable global (congela / habilita el core)" style="text;html=1;align=left;fontSize=10;fontColor=#adbac7;" vertex="1" parent="1"><mxGeometry x="320" y="981" width="280" height="18" as="geometry" /></mxCell>
        <mxCell id="lg5" value="" style="endArrow=block;html=1;strokeColor=#a371f7;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="990" as="sourcePoint" /><mxPoint x="590" y="990" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg5t" value="lectura de estado (dump: PC/regs/mem)" style="text;html=1;align=left;fontSize=10;fontColor=#adbac7;" vertex="1" parent="1"><mxGeometry x="598" y="981" width="280" height="18" as="geometry" /></mxCell>

        <!-- ===================== FLUJO DE USO ===================== -->
        <mxCell id="flow" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#30363d;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="910" y="860" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="flow_t" value="Flujo de operacion" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#c9d1d9;" vertex="1" parent="1">
          <mxGeometry x="928" y="870" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flow_b" value="1.&#160;El Host envia el binario byte a byte por UART (i_rx).&#10;2.&#160;UartRx convierte serie&#8594;paralelo; la DebugUnit ensambla 4 bytes en cada instruccion de 32 bits y la escribe en InstructionMemory.&#10;3.&#160;Con CONTINUE/STEP, la DebugUnit pone i_if_enable=1 y el pipeline ejecuta IF&#8594;ID&#8594;EX&#8594;MEM&#8594;WB hasta HALT.&#10;4.&#160;Con SEND_INFO, la DebugUnit lee PC, los 32 registros y la memoria de datos, y los transmite (UartTx&#8594;o_tx) de vuelta al Host.&#10;&#10;Nota: la UART nunca habla directo con el pipeline; la DebugUnit es el unico puente entre ambos." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#adbac7;" vertex="1" parent="1">
          <mxGeometry x="928" y="894" width="770" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
